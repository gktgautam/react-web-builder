{
  "name": "react-page-builder-workspace",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "workspaces": [
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r --parallel build",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
